meta {
  name: Ingest Tableflow with Player Slug
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/ingest/tableflow
  body: json
  auth: none
}

headers {
  X-Tableflow-Secret: {{tableflowSecret}}
}

