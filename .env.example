KEYCLOAK_ADMIN_PASSWORD=admin_password

# Tableflow Webhook Secret
TABLEFLOW_WEBHOOK_SECRET=tableflow-webhook-dev-secret

# Linear Tracker
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
